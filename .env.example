# ------------------------------------------------------------------
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.  (cp .env.example .env.local)
# 값은 Supabase 대시보드 > Project Settings > API Keys / Data API 에서 확인합니다.
# ------------------------------------------------------------------

# Project URL (예: https://abcdefghijk.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_... ) — 예전 화면에서는 "anon public" 키
# 브라우저에 노출되어도 되는 키입니다. (RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_... ) — 예전 화면에서는 "service_role" 키
# 절대 외부에 공유하지 마세요. 앞에 NEXT_PUBLIC_ 을 붙이면 안 됩니다!
SUPABASE_SECRET_KEY=

# 관리자 코드: 직접 정하는 비밀 문구 (8자 이상 권장). 서버에서만 사용됩니다.
ADMIN_CODE=
